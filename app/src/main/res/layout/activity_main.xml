<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_light"
        app:title="@string/app_name"
        app:titleTextColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_keyboard_test"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/keyboardTestInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/keyboard_test_hint"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="2"
            android:minHeight="@dimen/settings_touch_height"
            android:padding="@dimen/space_md"
            android:saveEnabled="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="@dimen/settings_title_size" />

        <Button
            android:id="@+id/clearKeyboardTest"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/settings_touch_height"
            android:minHeight="@dimen/settings_touch_height"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/keyboard_test_clear"
            android:textColor="@color/primary" />
    </LinearLayout>

    <!-- Tab pages share this area; the navigation bar below switches between them. -->
    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xl" />

        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pagePurify"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/purifyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xl" />

        </androidx.core.widget.NestedScrollView>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pageKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/keyboardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_xl" />

        </androidx.core.widget.NestedScrollView>

        <include
            layout="@layout/page_appearance"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Shown after a change that only applies once the input method restarts. -->
    <LinearLayout
        android:id="@+id/restartBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_restart_bar"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRestartBar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:minHeight="@dimen/settings_touch_height"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:text="@string/restart_to_apply"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <!-- Navigation items are built in code. -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:background="@color/surface_light"
        android:orientation="horizontal" />

</LinearLayout>
